{
  "name": "techbench-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p app && vite build",
    "typecheck": "tsc --noEmit -p app",
    "tauri": "tauri",
    "build:wasm": "cargo build -p tb-wasm --target wasm32-unknown-unknown --release --locked",
    "build:web": "npm run build:wasm && tsc --noEmit -p app && vite build --mode web",
    "preview:web": "vite preview --mode web",
    "test:web": "playwright test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.12.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0"
  }
}
