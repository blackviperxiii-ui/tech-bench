@echo off
rem Generate sources\*.rsp from sources\*.list and tests\*.cs globs (rearch stage 5).
rem Called by build.bat / test.bat. Do not hand-edit the generated .rsp files.
rem Membership: edit sources\core.list / sources\app.list; tests\*.cs are picked up automatically.
cd /d "%~dp0.."
if not exist "sources\core.list" (
  echo gen-rsp: missing sources\core.list
  exit /b 1
)
if not exist "sources\app.list" (
  echo gen-rsp: missing sources\app.list
  exit /b 1
)

> "sources\core.rsp" echo # GENERATED by tools\gen-rsp.bat - do not edit; change sources\core.list
for /f "usebackq eol=# delims=" %%f in ("sources\core.list") do (
  if not "%%f"=="" echo %%f>> "sources\core.rsp"
)

> "sources\app.rsp" echo # GENERATED by tools\gen-rsp.bat - do not edit; change sources\app.list
for /f "usebackq eol=# delims=" %%f in ("sources\app.list") do (
  if not "%%f"=="" echo %%f>> "sources\app.rsp"
)

> "sources\selftest.rsp" echo # GENERATED by tools\gen-rsp.bat - do not edit; add tests\*.cs
if exist "tests\*.cs" (
  for /f "delims=" %%f in ('dir /b /o:n "tests\*.cs"') do (
    echo tests\%%f>> "sources\selftest.rsp"
  )
)

exit /b 0
